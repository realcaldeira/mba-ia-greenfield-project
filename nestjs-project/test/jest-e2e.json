{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "/node_modules/@nestjs/(bullmq|bull-shared)/.+\\.js$": [
      "ts-jest",
      {
        "tsconfig": {
          "allowJs": true,
          "module": "commonjs",
          "target": "ES2023"
        }
      }
    ],
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!@nestjs/(bullmq|bull-shared)/)"
  ],
  "setupFiles": ["dotenv/config", "<rootDir>/../src/test/setup-test-env.ts"]
}
