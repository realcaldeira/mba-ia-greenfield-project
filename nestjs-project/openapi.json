    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {}
      },
      "ResendConfirmationDto": {
        "type": "object",
        "properties": {}
      },
      "LoginDto": {
        "type": "object",
        "properties": {}
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {}
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "InitiateUploadDto": {
        "type": "object",
        "properties": {}
      },
      "VideoStatus": {
        "type": "string",
        "enum": [
          "draft",
          "processing",
          "ready",
          "failed"
        ]
      },
      "UploadPartUrlDto": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "number",
            "example": 1
          },
          "url": {
            "type": "string",
            "description": "Presigned UploadPart PUT URL"
          }
        },
        "required": [
          "part_number",
          "url"
        ]
      },
      "UploadSessionResponseDto": {
        "type": "object",
        "properties": {
          "public_id": {
            "type": "string",
            "example": "AbCdEf_-123",
            "pattern": "^[A-Za-z0-9_-]{11}$"
          },
          "title": {
            "type": "string",
            "example": "My trip"
          },
          "status": {
            "example": "draft",
            "allOf": [
              {
                "$ref": "#/components/schemas/VideoStatus"
              }
            ]
          },
          "part_size": {
            "type": "number",
            "example": 67108864
          },
          "part_count": {
            "type": "number",
            "example": 2
          },
          "uploaded_parts": {
            "example": [],
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadPartUrlDto"
            }
          },
          "parts_expire_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-05T13:00:00.000Z"
          },
          "upload_expires_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-06T12:00:00.000Z"
          }
        },
        "required": [
          "public_id",
          "title",
          "status",
          "part_size",
          "part_count",
          "uploaded_parts",
          "parts",
          "parts_expire_at",
          "upload_expires_at"
        ]
      },
      "VideoMetadataDto": {
        "type": "object",
        "properties": {
          "width": {
            "type": "number",
            "example": 1920
          },
          "height": {
            "type": "number",
            "example": 1080
          },
          "video_codec": {
            "type": "string",
            "example": "h264"
          },
          "audio_codec": {
            "type": "string",
            "nullable": true,
            "example": "aac"
          },
          "bit_rate": {
            "type": "number",
            "nullable": true,
            "example": 4500000
          },
          "frame_rate": {
            "type": "number",
            "nullable": true,
            "example": 29.97
          },
          "format_name": {
            "type": "string",
            "example": "mov,mp4,m4a,3gp,3g2,mj2"
          }
        },
        "required": [
          "width",
          "height",
          "video_codec",
          "audio_codec",
          "bit_rate",
          "frame_rate",
          "format_name"
        ]
      },
      "VideoProcessingError": {
        "type": "string",
        "enum": [
          "UNSUPPORTED_MEDIA",
          "PROCESSING_FAILED",
          "UPLOAD_EXPIRED"
        ]
      },
      "VideoResponseDto": {
        "type": "object",
        "properties": {
          "public_id": {
            "type": "string",
            "example": "AbCdEf_-123",
            "pattern": "^[A-Za-z0-9_-]{11}$"
          },
          "title": {
            "type": "string",
            "example": "My trip"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/VideoStatus"
              }
            ]
          },
          "size_bytes": {
            "type": "number",
            "example": 104857600
          },
          "mime_type": {
            "type": "string",
            "example": "video/mp4"
          },
          "duration_seconds": {
            "type": "number",
            "nullable": true,
            "example": 12.5
          },
          "metadata": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/VideoMetadataDto"
              }
            ]
          },
          "processing_error": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/VideoProcessingError"
              }
            ]
          },
          "thumbnail_url": {
            "type": "string",
            "nullable": true,
            "description": "Presigned GET of the thumbnail, only for ready videos"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-05T12:00:00.000Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-05T12:00:00.000Z"
          }
        },
        "required": [
          "public_id",
          "title",
          "status",
          "size_bytes",
          "mime_type",
          "duration_seconds",
          "metadata",
          "processing_error",
          "thumbnail_url",
          "created_at",
          "updated_at"
        ]
      },
      "UploadCompleteResponseDto": {
        "type": "object",
        "properties": {
          "public_id": {
            "type": "string",
            "example": "AbCdEf_-123",
            "pattern": "^[A-Za-z0-9_-]{11}$"
          },
          "status": {
            "example": "processing",
            "allOf": [
              {
                "$ref": "#/components/schemas/VideoStatus"
              }
            ]
          }
        },
        "required": [
          "public_id",
          "status"
        ]
      },
      "MediaUrlResponseDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Presigned GET URL of the original video"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-05T13:00:00.000Z"
          }
        },
        "required": [
          "url",
          "expires_at"
        ]
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "error": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Invalid email or password"
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      }
    }
  }
}