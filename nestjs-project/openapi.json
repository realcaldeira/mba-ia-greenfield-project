              }
            }
          },
          "503": {
            "description": "Storage is unavailable while aborting the upload of an expired draft (STORAGE_UNAVAILABLE); the video is already failed/UPLOAD_EXPIRED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Get a download URL",
        "tags": [
          "videos"
        ]
      }
    }
  },
  "info": {
