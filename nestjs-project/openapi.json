    "/videos": {
      "post": {
        "description": "Registers the video as a draft in the caller's channel and opens a multipart upload in the storage. Returns one presigned PUT URL per 64 MiB part; the bytes go straight to the storage.",
        "operationId": "VideosController_initiateUpload",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InitiateUploadDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Draft created and multipart upload started",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadSessionResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "The caller has no channel (CHANNEL_NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Storage is unavailable (STORAGE_UNAVAILABLE)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Start a video upload",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{publicId}": {
      "get": {
        "description": "Returns the lifecycle of one of the caller's videos. A draft past its upload window is marked failed/UPLOAD_EXPIRED before the response. The thumbnail URL is presigned only for ready videos.",
        "operationId": "VideosController_getVideo",
        "parameters": [
          {
            "name": "publicId",
            "required": true,
            "in": "path",
            "description": "Public video identifier",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{11}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Video found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Malformed publicId",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown video or owned by another user (VIDEO_NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Storage is unavailable while aborting the upload of an expired draft (STORAGE_UNAVAILABLE); the video is already failed/UPLOAD_EXPIRED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Get a video",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{publicId}/upload": {
      "get": {
        "description": "Lists the parts the storage already received and returns fresh presigned PUT URLs only for the missing ones. Only for drafts within their upload window.",
        "operationId": "VideosController_getUploadSession",
        "parameters": [
          {
            "name": "publicId",
            "required": true,
            "in": "path",
            "description": "Public video identifier",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{11}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Upload session with the missing parts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadSessionResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Malformed publicId",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown video or owned by another user (VIDEO_NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Video is not a draft (and not upload-expired), or its original is already assembled (INVALID_VIDEO_STATE)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "410": {
            "description": "Upload window expired, multipart upload gone from the storage, or video already failed/UPLOAD_EXPIRED (UPLOAD_EXPIRED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Storage is unavailable (STORAGE_UNAVAILABLE): ListParts, HeadObject, or the abort of an expired draft",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Resume a video upload",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{publicId}/upload/complete": {
      "post": {
        "description": "Checks the uploaded parts in the storage, assembles the original and enqueues its processing. Idempotent: repeating it on a video already in processing re-enqueues the same job, and after a 503 QUEUE_UNAVAILABLE it can be repeated without re-sending any part. Concurrent calls on the same upload are safe: the one that finds the upload already assembled checks the original and answers 202 (410 UPLOAD_EXPIRED when there is no original).",
        "operationId": "VideosController_completeUpload",
        "parameters": [
          {
            "name": "publicId",
            "required": true,
            "in": "path",
            "description": "Public video identifier",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{11}$"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Upload accepted; processing enqueued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadCompleteResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Malformed publicId",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown video or owned by another user (VIDEO_NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "UPLOAD_INCOMPLETE: missing or non-contiguous parts, or parts the storage rejects on assembly (video stays draft). UPLOAD_SIZE_MISMATCH: a part other than the last is not part_size, the last exceeds it, or the uploaded size differs from the declared one (draft on the pre-check; failed/PROCESSING_FAILED when the assembled object differs). INVALID_VIDEO_STATE: video is ready, or failed for a reason other than UPLOAD_EXPIRED.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "410": {
            "description": "Upload window expired, multipart upload and object gone from the storage, or video already failed/UPLOAD_EXPIRED (UPLOAD_EXPIRED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "QUEUE_UNAVAILABLE: the enqueue failed or did not finish within QUEUE_ENQUEUE_TIMEOUT_MS (video back to draft; repeat the same call). STORAGE_UNAVAILABLE: storage unreachable, including the abort of an expired draft.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Complete a video upload",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{publicId}/stream": {
      "get": {
        "description": "Returns a presigned GET URL of the original for inline playback; the storage serves Range requests with 206. The URL lives clamp(2 × duration, 1 h, 12 h), or 1 h without a duration. Only for ready videos.",
        "operationId": "VideosController_getStreamUrl",
        "parameters": [
          {
            "name": "publicId",
            "required": true,
            "in": "path",
            "description": "Public video identifier",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{11}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Presigned streaming URL",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaUrlResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Malformed publicId",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown video or owned by another user, in any state (VIDEO_NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Video is draft, processing or failed (VIDEO_NOT_READY)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Storage is unavailable while aborting the upload of an expired draft (STORAGE_UNAVAILABLE); the video is already failed/UPLOAD_EXPIRED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Get a streaming URL",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{publicId}/download": {
      "get": {
        "description": "Returns a presigned GET URL of the original, valid for 1 h, that saves the file under the name declared at upload (ASCII fallback plus RFC 5987 filename*). Only for ready videos.",
        "operationId": "VideosController_getDownloadUrl",
        "parameters": [
          {
            "name": "publicId",
            "required": true,
            "in": "path",
            "description": "Public video identifier",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{11}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Presigned download URL",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaUrlResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Malformed publicId",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown video or owned by another user, in any state (VIDEO_NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Video is draft, processing or failed (VIDEO_NOT_READY)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
